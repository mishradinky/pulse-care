{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patient simulator output",
  "type": "object",
  "required": ["utterance"],
  "properties": {
    "utterance": {"type": "string", "minLength": 1},
    "internal_state": {
      "type": "object",
      "properties": {
        "emotion":            {"type": "string"},
        "cooperation_level":  {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
